diff --git a/meson.options b/meson.options
index 3424385..5c593e4 100644
--- a/meson.options
+++ b/meson.options
@@ -19,3 +19,14 @@ option('enable_nvngx', type : 'boolean', value : false)
 # meson.build). Raise it only when the shaders need a newer standard: a device
 # refuses a library written for a version its OS does not know.
 option('metal_std', type : 'string', value : 'metal3.1')
+# MADEIRA (macOS x86_64 Wine build): compile the madeira-d3d12 shader-converter
+# service (madeira_ir_unix.mm and its two helpers) into winemetal.so, so a
+# stock x86_64 macOS Wine can run the D3D12 runtime. On iOS the same objects
+# are produced by build/dxmt-ios/build.sh into the app's static library; the
+# option exists so that the macOS .so is built by meson like upstream DXMT's.
+# Value: path to the madeira-d3d12 directory ('' = not built).
+option('madeira_d3d12_path', type : 'string', value : '')
+# Include directory holding metal_irconverter/ (the vendored converter headers).
+option('madeira_msc_include', type : 'string', value : '')
+# Identity of the converter build for the DXIL cache key (see build/dxmt-ios/build.sh).
+option('madeira_converter_id', type : 'string', value : 'macos-dev')
