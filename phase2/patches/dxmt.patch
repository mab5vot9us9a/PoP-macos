index 694fa31..aff2241 100644
--- a/src/winemetal/unix/meson.build
+++ b/src/winemetal/unix/meson.build
@@ -1,6 +1,9 @@
 winemetal_unix_src = [
   'winemetal_unix.c',
   'cache.c',
+  # MADEIRA: no-op definitions of the hooks the iOS app provides (macOS build only;
+  # this meson target is never built for iOS, see build/dxmt-ios/build.sh).
+  'wmt_macos_stubs.c',
 ]
 
 if wine_build_path != ''
@@ -25,10 +28,70 @@ winemetal_unix_ld_args = [
 ]
 winemetal_unix_link_depends = []
 
+# MADEIRA (macOS x86_64 Wine build, see meson.options madeira_d3d12_path): the
+# shader-converter service and its two helpers, compiled into winemetal.so the
+# way build/dxmt-ios/build.sh compiles them into the iOS static library. The
+# three objects are built as a separate static library because each needs its
+# own language and flags (Objective-C++ with ARC; C++ without exceptions; C++
+# with LLVM's bitcode reader), and winemetal.so above is a plain C target.
+madeira_d3d12_path = get_option('madeira_d3d12_path')
+if madeira_d3d12_path != ''
+  add_languages('objcpp', native: true, required: true)
+  madeira_msc_include = get_option('madeira_msc_include')
+  if madeira_msc_include == ''
+    error('-Dmadeira_msc_include is required with -Dmadeira_d3d12_path')
+  endif
+  if not madeira_d3d12_path.startswith('/')
+    madeira_d3d12_path = join_paths(meson.project_source_root(), madeira_d3d12_path)
+  endif
+  madeira_unix = join_paths(madeira_d3d12_path, 'src/unix')
+  madeira_inc = include_directories(
+    join_paths(madeira_d3d12_path, 'src'),
+    madeira_msc_include,
+    '../../airconv',
+    '../../../include/native/directx',
+    '../../../include/native/windows',
+  )
+  madeira_common_args = [
+    '-DMADEIRA_IR_CONVERTER_ID="' + get_option('madeira_converter_id') + '"',
+    '-D_FILE_OFFSET_BITS=64', '-D__STDC_CONSTANT_MACROS',
+    '-D__STDC_FORMAT_MACROS', '-D__STDC_LIMIT_MACROS',
+    '-Wno-extern-c-compat', '-Wno-unused-parameter',
+    '-Wno-missing-field-initializers', '-Wno-missing-braces',
+    '-Wno-unused-const-variable',
+  ]
+  madeira_ir_lib = static_library('madeira_ir_unix',
+    [join_paths(madeira_unix, 'madeira_ir_unix.mm')],
+    include_directories : [ dxmt_include_path, madeira_inc ],
+    objcpp_args         : [ madeira_common_args, '-arch', 'x86_64', '-std=c++20', '-fobjc-arc' ],
+    native              : true,
+  )
+  madeira_helpers_lib = static_library('madeira_helpers_unix',
+    [join_paths(madeira_unix, 'madeira_sm5_ia.cpp'),
+     join_paths(madeira_unix, 'madeira_ags.cpp')],
+    include_directories : [ dxmt_include_path, madeira_inc, llvm_include_path_darwin ],
+    cpp_args            : [ madeira_common_args, '-fno-exceptions', '-fno-rtti' ],
+    native              : true,
+  )
+  # The converter runtime header (metal_irconverter_runtime.h) emits its helper
+  # bodies only in the one translation unit that defines IR_PRIVATE_IMPLEMENTATION;
+  # on iOS that is the M1 canary. Nothing in winemetal.so needs them, so no
+  # canary is linked here.
+  madeira_unix_dep = declare_dependency(
+    link_whole : [ madeira_ir_lib, madeira_helpers_lib ],
+  )
+  # Linking an Objective-C++ archive makes meson link winemetal.so with the
+  # Objective-C++ driver, which meson.build gives no -arch x86_64 link flag.
+  winemetal_unix_ld_args += ['-arch', 'x86_64']
+else
+  madeira_unix_dep = declare_dependency()
+endif
+
 shared_library('winemetal', winemetal_unix_src,
   name_prefix         : '',
-  dependencies        : [ airconv_dep_darwin ],
-  include_directories : dxmt_include_path,
+  dependencies        : [ airconv_dep_darwin , madeira_unix_dep ],
+  # '..' : wmt_remote_pack.h (Madeira's remote-Metal transport) includes winemetal.h by name
+  include_directories : [ dxmt_include_path, include_directories('..') ],
   c_args              : ['-ObjC'],
   link_args           : winemetal_unix_ld_args,
   native              : true,
