index 0000000..8bff8de
--- /dev/null
+++ b/madeira-d3d12/src/pe/indirect_mesh.metal
@@ -0,0 +1,32 @@
+// Indirect draws on geometry/tessellation-emulation pipelines (madeira_d3d12.c,
+// exec_draw): the D3D12 argument record is GPU-written, so the object-threadgroup
+// grid the converter's draw contract needs is computed here, one thread per draw.
+//
+// Slot layout, 64 bytes (MAD_INDMESH_SLOT_BYTES), written by the CPU except where noted:
+//    0  MTLDispatchThreadgroupsIndirectArguments {x, y, z}  -- written here
+//   16  IRRuntimeDrawInfo (24 bytes, the template mad_gs_draw/mad_ts_draw built);
+//       gs_instance_count (uint16 at byte 10 of it) is patched here when asked
+//   40  {stride, overlap, set_instances, 0}
+//
+// args: the D3D12_DRAW_ARGUMENTS / D3D12_DRAW_INDEXED_ARGUMENTS record; both start
+// with {count, instance count}.
+#include <metal_stdlib>
+using namespace metal;
+
+kernel void mad_indirect_mesh(device const uint *args [[buffer(0)]],
+                              device uint *slot [[buffer(1)]],
+                              uint tid [[thread_position_in_grid]])
+{
+    if (tid != 0u) return;
+    uint count = args[0], inst = args[1];
+    uint stride = slot[10], overlap = slot[11], set_inst = slot[12];
+    uint n = count > overlap ? count - overlap : 0u;
+    if (stride == 0u) stride = 1u;
+    slot[0] = (n + stride - 1u) / stride;
+    slot[1] = inst ? inst : 1u;
+    slot[2] = 1u;
+    if (set_inst) {
+        uint w = slot[4 + 2];
+        slot[4 + 2] = (w & 0x0000ffffu) | (((inst ? inst : 1u) & 0xffffu) << 16);
+    }
+}
