+#!/bin/bash
+# Build the madeira-d3d12 runtime for a stock x86_64 macOS Wine (no FEX, no
+# iOS): winemetal.dll + winemetal.so from the dxmt submodule, then d3d12.dll,
+# madeira_d3d12.dll, d3d12core.dll and the x86_64 test executables.
+#
+# Inputs (see docs/MACOS_X86_64.md):
+#   toolchains/llvm-mingw-20260421-ucrt-macos-universal   llvm-mingw (PE side)
+#   toolchains/llvm-darwin                                 LLVM 15 x86_64 static libs (airconv)
+#   toolchains/wine                                        a Wine SDK with bin/winebuild,
+#                                                          lib/wine/x86_64-windows/lib{winecrt0,ntdll,dbghelp}.a,
+#                                                          lib/wine/x86_64-unix/{ntdll,winemac}.so
+#   research/GPTK/Metal Shader Converter 4.0 beta 2.pkg    (deps.sh verifies it)
+#
+# Output: build/madeira-d3d12/out-macos/ with everything to copy into a Wine
+# tree plus install.sh notes.
+set -eu
+DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$DIR/../.." && pwd)"
+DXMT="$REPO_ROOT/dxmt"
+BUILD="$DXMT/build-x86_64"
+OUT="${OUT:-$DIR/out-macos}"
+
+source "$DIR/deps.sh"
+[[ "$MSC_HAVE_PKG" == 1 ]] || { echo "build-macos: the converter package is required (macOS dylib)" >&2; exit 1; }
+
+# Converter identity for the DXIL cache key: the same inputs as build/dxmt-ios/build.sh,
+# with the macOS dylib in place of the iOS one.
+converter_id_inputs() {
+    local f x
+    for f in "$REPO_ROOT/madeira-d3d12/src/unix" "$REPO_ROOT/madeira-d3d12/src/madeira_ir_abi.h" \
+             "$DIR/build-macos-x86_64.sh" "$DXMT/src/airconv" "$DXMT/libs" \
+             "$REPO_ROOT/toolchains/llvm-darwin/include/llvm/Config/llvm-config.h" "$MSC_INCLUDE" "$MSC_LIB_MACOS"; do
+        [ -e "$f" ] || { echo "absent ${f#"$REPO_ROOT"/}"; continue; }
+        find "$f" -type f | LC_ALL=C sort | while read -r x; do
+            echo "$(shasum -a 256 < "$x" | cut -c1-64) ${x#"$REPO_ROOT"/}"
+        done
+    done
+}
+CONVERTER_ID=$(converter_id_inputs | shasum -a 256 | cut -c1-16)
+echo "=== shader cache converter identity $CONVERTER_ID"
+
+if [[ ! -f "$BUILD/build.ninja" ]]; then
+    echo "=== meson setup $BUILD ==="
+    meson setup "$BUILD" "$DXMT" \
+        --cross-file "$DXMT/build-x86_64-win.txt" --native-file "$DXMT/build-osx.txt" \
+        -Dbuildtype=release \
+        -Dwine_install_path="$REPO_ROOT/toolchains/wine" \
+        -Dnative_llvm_path="$REPO_ROOT/toolchains/llvm-darwin" \
+        -Dmadeira_d3d12_path="$REPO_ROOT/madeira-d3d12" \
+        -Dmadeira_msc_include="$MSC_INCLUDE" \
+        -Dmadeira_converter_id="$CONVERTER_ID"
+fi
+
+echo "=== winemetal.dll + winemetal.so (x86_64) ==="
+ninja -C "$BUILD" src/winemetal/winemetal.dll src/winemetal/winemetal.dll.postproc src/winemetal/unix/winemetal.so src/dxgi/dxgi.dll
+
+echo "=== D3D12 PE side (x86_64) ==="
+MADEIRA_PE_ARCH=x86_64 OUT="$OUT" bash "$DIR/build-pe.sh"
+
+cp "$BUILD/src/winemetal/winemetal.dll" "$OUT/winemetal.dll"
+cp "$BUILD/src/winemetal/unix/winemetal.so" "$OUT/winemetal.so"
+cp "$BUILD/src/dxgi/dxgi.dll" "$OUT/dxgi.dll"   # DXMT's dxgi: the swapchain bridge (IMTLDXGIDevice) lives behind it
+cp "$MSC_LIB_MACOS" "$OUT/libmetalirconverter.dylib"
+echo "=== staged in $OUT ==="
+ls -l "$OUT"
